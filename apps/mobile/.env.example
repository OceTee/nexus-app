# Copy to .env for local development. EXPO_PUBLIC_* values are baked into the app bundle,
# so never put secrets here.

# API base URL. On a USB/Wi-Fi debugged phone, run `adb reverse tcp:4000 tcp:4000` so
# localhost on the phone reaches the API on this machine.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Sentry DSN for the mobile app (public by design).
SENTRY_DSN_MOBILE=
