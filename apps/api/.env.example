# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent (defaults: debug locally, info in production)
LOG_LEVEL=debug
# Comma-separated browser origins allowed by CORS (native apps send no Origin).
CORS_ORIGINS=http://localhost:8081
# all | api | worker
ROLE=all

# --- Used from Phase 3 onward -------------------------------------------------
# Local Docker Postgres (docker compose up -d) or a Neon dev branch.
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus
DATABASE_URL_DIRECT=postgres://nexus:nexus@localhost:5432/nexus

# --- Used from Phase 4 onward -------------------------------------------------
# 256-bit secret, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
JWT_SECRET=
JWT_KID=dev-1
RESEND_API_KEY=
MAIL_FROM=NEXUS <no-reply@nexus.example>
APP_URL=http://localhost:8081

# --- Attachments (R2 in staging/production, MinIO locally) ---------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=nexus
R2_SECRET_ACCESS_KEY=nexus-dev-secret
R2_BUCKET=nexus-attachments-dev
R2_ENDPOINT=http://localhost:9000

# --- Push and monitoring --------------------------------------------------------
EXPO_ACCESS_TOKEN=
SENTRY_DSN_API=
