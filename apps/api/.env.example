# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent (defaults: debug locally, info in production)
LOG_LEVEL=debug
# Comma-separated browser origins allowed by CORS (native apps send no Origin).
CORS_ORIGINS=http://localhost:8081
# all | api | worker
ROLE=all

# --- Database -----------------------------------------------------------------
# Local Docker Postgres (docker compose up -d) or a Neon dev branch.
# The API connects as nexus_api, which row-level security applies to.
DATABASE_URL=postgres://nexus_api:nexus-api-dev@localhost:5432/nexus
# Migrations and the seed run as the schema owner.
DATABASE_URL_DIRECT=postgres://nexus:nexus@localhost:5432/nexus
# Local/CI only: db:migrate enables login for nexus_api with this password.
NEXUS_API_PASSWORD=nexus-api-dev
# Password for demo@nexus.example created by db:seed.
DEMO_PASSWORD=demo-password-123
# pg-boss (jobs) needs a role that can create the pgboss schema; locally the owner.
JOBS_DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus
# postgres (default) or memory
RATE_LIMIT_STORE=postgres

# --- Auth and email -----------------------------------------------------------
# 256-bit secret, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
JWT_SECRET=change-me-to-a-random-256-bit-secret-value
JWT_KID=dev-1
# During rotation: the old secret and kid, still accepted for 15 minutes.
# JWT_SECRET_PREVIOUS=
# JWT_KID_PREVIOUS=
# Without a Resend key, emails are logged instead of sent.
# RESEND_API_KEY=
MAIL_FROM=NEXUS <no-reply@nexus.example>
APP_URL=http://localhost:8081

# --- Attachments (R2 in staging/production, MinIO locally) ---------------------
# R2: set R2_ACCOUNT_ID (endpoint derived) or R2_ENDPOINT. Locally: MinIO from docker compose.
# R2_ACCOUNT_ID=
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=nexus
R2_SECRET_ACCESS_KEY=nexus-dev-secret
R2_BUCKET=nexus-attachments-dev

# --- Background jobs --------------------------------------------------------------
# Cross-user maintenance (nexus_maint with BYPASSRLS). Locally the owner works.
DATABASE_URL_MAINT=postgres://nexus:nexus@localhost:5432/nexus
# age public key for the nightly encrypted backup (age-keygen); unset skips backups.
# BACKUP_AGE_RECIPIENT=age1...
# Server-side export generation (post-MVP).
FEATURE_SERVER_EXPORTS=false

# --- Push and monitoring --------------------------------------------------------
# EXPO_ACCESS_TOKEN=
SENTRY_DSN_API=
