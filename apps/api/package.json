{
  "name": "@nexus/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NEXUS HTTP API (Express 5).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test:db": "vitest run --project db"
  },
  "dependencies": {
    "@nexus/shared": "workspace:*",
    "argon2": "^0.45.2",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
