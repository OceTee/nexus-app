{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.nexus.example/schemas/nexus-export.schema.json",
  "title": "NEXUS JSON export",
  "type": "object",
  "required": ["format", "version", "exportedAt", "notes", "collections", "tags", "attachments"],
  "properties": {
    "format": { "const": "nexus-json" },
    "version": { "const": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "bodyMd",
          "createdAt",
          "updatedAt",
          "isPinned",
          "collectionId",
          "tagIds",
          "links"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/uuid" },
          "title": { "type": "string", "maxLength": 200 },
          "bodyMd": { "type": "string", "maxLength": 200000 },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "isPinned": { "type": "boolean" },
          "collectionId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
          "tagIds": { "type": "array", "items": { "$ref": "#/$defs/uuid" }, "maxItems": 50 },
          "links": { "type": "array", "items": { "type": "string" } },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rev", "title", "bodyMd", "createdAt"],
              "properties": {
                "rev": { "type": "integer", "minimum": 0 },
                "title": { "type": "string" },
                "bodyMd": { "type": "string" },
                "createdAt": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "parentId", "name"],
        "properties": {
          "id": { "$ref": "#/$defs/uuid" },
          "parentId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
          "name": { "type": "string", "maxLength": 80 }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "colour"],
        "properties": {
          "id": { "$ref": "#/$defs/uuid" },
          "name": { "type": "string", "maxLength": 40 },
          "colour": {
            "oneOf": [{ "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, { "type": "null" }]
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "noteId", "filename", "mimeType", "sizeBytes", "sha256"],
        "properties": {
          "id": { "$ref": "#/$defs/uuid" },
          "noteId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
          "filename": { "type": "string", "maxLength": 255 },
          "mimeType": { "enum": ["image/jpeg", "image/png", "image/webp", "application/pdf"] },
          "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 26214400 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
