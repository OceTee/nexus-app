meta {
  name: Edit a note
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/v1/notes/:noteId
  body: json
  auth: bearer
}

params:path {
  noteId: 01900000-0000-7000-8000-000000000001
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "title": "Hello from Bruno",
    "bodyMd": "Written from the API client. See [[Another note]].",
    "baseRev": 1
  }
}

docs {
  PATCH /v1/notes/{noteId} (operationId: patchNotesByNoteId)

  Responses: 200, 400, 401, 429, default
}
