meta {
  name: Create a note
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/notes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "id": "01900000-0000-7000-8000-000000000001",
    "title": "Hello from Bruno",
    "bodyMd": "Written from the API client. See [[Another note]]."
  }
}

docs {
  POST /v1/notes (operationId: postNotes)

  Responses: 201, 400, 401, 429, default
}
