meta {
  name: Replace a note's tags
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/v1/notes/:noteId/tags
  body: json
  auth: bearer
}

params:path {
  noteId: 01900000-0000-7000-8000-000000000001
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "tagIds": []
  }
}

docs {
  PUT /v1/notes/{noteId}/tags (operationId: putNotesByNoteIdTags)

  Responses: 200, 400, 401, 429, default
}
