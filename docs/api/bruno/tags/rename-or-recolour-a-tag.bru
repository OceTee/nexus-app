meta {
  name: Rename or recolour a tag
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/v1/tags/:tagId
  body: json
  auth: bearer
}

params:path {
  tagId: 01900000-0000-7000-8000-000000000001
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "baseRev": 1
  }
}

docs {
  PATCH /v1/tags/{tagId} (operationId: patchTagsByTagId)

  Responses: 200, 400, 401, 429, default
}
