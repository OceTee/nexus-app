meta {
  name: A note's neighbourhood
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/graph/neighbours/:noteId
  body: none
  auth: bearer
}

params:query {
  ~depth: 1
}

params:path {
  noteId: 01900000-0000-7000-8000-000000000001
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  GET /v1/graph/neighbours/{noteId} (operationId: getGraphNeighboursByNoteId)

  Responses: 200, 400, 401, 429, default
}
