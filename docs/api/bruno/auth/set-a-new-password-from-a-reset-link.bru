meta {
  name: Set a new password from a reset link
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/v1/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "token-from-the-email-link",
    "password": "{{password}}"
  }
}

docs {
  POST /v1/auth/reset-password (operationId: postAuthResetPassword)

  Responses: 204, 400, 429, default
}
