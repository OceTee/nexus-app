meta {
  name: Change the password
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/v1/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "currentPassword": "{{password}}",
    "newPassword": "a-new-long-password"
  }
}

docs {
  POST /v1/auth/change-password (operationId: postAuthChangePassword)

  Responses: 200, 400, 401, 429, default
}
