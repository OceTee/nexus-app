meta {
  name: Sign in this device
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "device": {
      "id": "{{deviceId}}",
      "name": "Bruno",
      "platform": "android",
      "appVersion": "1.0.1"
    }
  }
}

script:post-response {
  if (res.status < 300) {
    bru.setEnvVar("accessToken", res.body.accessToken);
    bru.setEnvVar("refreshToken", res.body.refreshToken);
  }
}

docs {
  POST /v1/auth/login (operationId: postAuthLogin)

  Responses: 200, 400, 429, default
}
