meta {
  name: Email a password reset link
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}"
  }
}

docs {
  POST /v1/auth/forgot-password (operationId: postAuthForgotPassword)

  Responses: 202, 400, 429, default
}
