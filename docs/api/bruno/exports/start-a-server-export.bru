meta {
  name: Start a server export
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/exports
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "format": "markdown_zip"
  }
}

docs {
  POST /v1/exports (operationId: postExports)

  Responses: 202, 400, 401, 429, default
}
