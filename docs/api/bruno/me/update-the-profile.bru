meta {
  name: Update the profile
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/v1/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "displayName": "Demo",
    "settings": {
      "telemetryOptIn": false,
      "push": {
        "newDeviceSignIn": false
      }
    }
  }
}

docs {
  PATCH /v1/me (operationId: patchMe)

  Responses: 200, 400, 401, 429, default
}
